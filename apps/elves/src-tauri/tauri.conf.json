{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Elves",
  "version": "1.0.0",
  "identifier": "com.elves.app",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "capabilities": ["connection-page", "content-appearance", "about-page"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost https://ipc.localhost; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/elves-app-icon.ico", "icons/elves-app-icon.png"]
  }
}
