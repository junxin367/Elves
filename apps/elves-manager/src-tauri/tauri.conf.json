{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Elves 代理管理器",
  "version": "1.0.0",
  "identifier": "com.elves.manager",
  "build": {
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../../elves-management/dist/manager"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Elves 代理管理器",
        "width": 1180,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost https://ipc.localhost; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": false
  }
}
